{
  "name": "apnibaat-hackarena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:web": "vite --host 127.0.0.1 --configLoader native",
    "dev:api": "node --env-file-if-exists=.env.local server/dev.mjs",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "demo": "node server/dev.mjs --serve-dist",
    "test:render": "node scripts/smoke-render.mjs",
    "test": "node --test server/guide.test.mjs server/transcribe.test.mjs src/flow.test.mjs src/voice/recorder.test.mjs shared/schemes.test.mjs src/journey.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
